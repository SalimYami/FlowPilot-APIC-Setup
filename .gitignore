# flow-pilot.properties

# IBM Flow Pilot kit — large binary, not redistributable
DonneesDipo/

# Generated MCP config (contains credentials injected by setup script)
.bob/

# macOS
.DS_Store
**/.DS_Store

# Node
node_modules/
npm-debug.log*

# Logs
*.log
logs/

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo
